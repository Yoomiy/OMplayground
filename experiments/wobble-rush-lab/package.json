{
  "name": "wobble-rush-3d",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Playground Wobble Rush fork: browser obstacle racing with a server-authoritative Node host.",
  "scripts": {
    "build": "bun run scripts/build.ts",
    "dev": "bun run build:action && node action-dist/main.mjs",
    "test": "bun test",
    "typecheck": "tsgo -p tsconfig.client.json && tsgo -p tsconfig.server.json && tsgo -p tsconfig.action.json",
    "build:action": "bun run scripts/build.ts && bun run scripts/build-action.ts",
    "start:action": "node action-dist/main.mjs",
    "lint": "biome check src tests scripts",
    "lint:fix": "biome check --write src tests scripts",
    "build:app": "bun run scripts/build-app.ts",
    "start:app": "node app-dist/server.mjs",
    "typecheck:app": "tsgo -p tsconfig.platform.json"
  },
  "dependencies": {
    "hono": "4.13.7",
    "pino": "9.14.0",
    "three": "latest",
    "ws": "8.21.0",
    "zod": "latest"
  },
  "devDependencies": {
    "@biomejs/biome": "latest",
    "@cloudflare/workers-types": "latest",
    "@playwright/test": "latest",
    "@types/bun": "^1.3.14",
    "@types/three": "latest",
    "@types/ws": "8.18.1",
    "@typescript/native-preview": "latest",
    "typescript": "latest",
    "wrangler": "latest"
  }
}
