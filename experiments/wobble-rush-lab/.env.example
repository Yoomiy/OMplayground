# Local-only Worker runtime; no Cloudflare account or production credentials.
# The actual systemd unit sets these explicitly.
WRANGLER_SEND_METRICS=false
BROWSER=none
# Public browser endpoints derive from location.origin: /api/* and /ws/*.
# Local backend: 127.0.0.1:19002. Native room limit: 8 players, minimum 2.

# Authoritative Node host (public service overrides the port to 19002).
ACTION_PORT=19003
ACTION_MAX_ROOMS=4
ACTION_STATIC_ROOT=dist
# Set the exact HTTPS origin when deployed behind Caddy:
# ACTION_ORIGIN=https://wobble.labs.play-ormenachem.com
