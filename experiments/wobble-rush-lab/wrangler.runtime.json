{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "playground-lab-wobble",
  "main": "worker-output/index.js",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "./dist", "binding": "ASSETS" },
  "kv_namespaces": [{ "binding": "BUDGET", "id": "local-lab-budget" }],
  "vars": {
    "CF_ACCOUNT_ID": "local-lab",
    "BILLING_ANCHOR_DAY": "1",
    "BUDGET_TRIP_RATIO": "0.95",
    "BUDGET_PLAN_TIER": "free"
  },
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "RoomDurableObject" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RoomDurableObject"] }],
  "dev": { "ip": "127.0.0.1", "port": 19002, "inspector_port": 0 }
}
