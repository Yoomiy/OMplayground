# Backend process. Published port allocation: rocket = 19001 (loopback only).
HOST=127.0.0.1
PORT=2567
NODE_ENV=production
ROCKET_ARENA_DEV_CONTROLS=false
# Vite development/preview proxy: must match the backend's PORT.
LAB_SERVER_PORT=2567
# Optional built-client label; public releases set this when building.
VITE_LAB_RELEASE=development
