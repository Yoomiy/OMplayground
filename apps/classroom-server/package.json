{
  "name": "@playground/classroom-server",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "prebuild": "npm --prefix ../.. run build -w @playground/observability",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "predev": "npm --prefix ../.. run build -w @playground/observability",
    "dev": "tsx watch src/index.ts",
    "lint": "tsc --noEmit",
    "pretest": "npm run build",
    "test": "node --experimental-vm-modules ../../node_modules/jest/bin/jest.js --config jest.config.cjs --runInBand",
    "verify:boundary": "NODE_ENV=production node tools/verify-boundary.cjs"
  },
  "dependencies": {
    "@playground/observability": "^0.0.1",
    "@supabase/supabase-js": "2.103.3",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "livekit-server-sdk": "2.15.4",
    "pino": "^9.6.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.14.0",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.3.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  },
  "engines": {
    "node": "24.21.0"
  }
}
