# apps/minecraft-server — copy to apps/minecraft-server/.env
PORT=8081
# Comma-separated; include 127.0.0.1 if you open the app that way (different origin from localhost)
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
# Classroom security logs: unavailable (default), direct (no proxy), or railway.
# Use railway only after verifying public ingress overwrites X-Real-IP and
# callers cannot bypass it. See docs/virtual_classrooms.md.
CLASSROOM_CLIENT_IP_SOURCE=unavailable
# Must be the full URL with https:// (same project as VITE_SUPABASE_URL)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME
