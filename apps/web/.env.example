# Frontend variables are public and included in the browser bundle.
# For a new setup, copy this file to apps/web/.env and fill in the two values below.
# For an existing setup, update its keys without replacing your configured values.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Local full stack: run `npm run dev:app` from the repository root, then open
# http://localhost:5173. Leave these overrides empty to use Vite's HTTP/WS proxies
# to the board server (8080), voxel server (3001), and classroom service (8083).
VITE_GAME_SERVER_URL=
VITE_VOXEL_RUNTIME_SERVER_URL=
VITE_CLASSROOM_SERVER_URL=

# For staging/production builds, set the three overrides above to the respective
# public HTTPS service origins, without /api paths. The board server still uses
# VITE_GAME_SERVER_URL; voxel and classroom each need their own URL.
# Restart Vite after local .env edits; rebuild Vercel deployments after changes.

# Optional Rocket/Wobble services, started separately from `dev:app`.
# Empty values use their local development defaults; hosted builds need HTTPS URLs.
VITE_ROCKET_SERVICE_URL=
VITE_WOBBLE_SERVICE_URL=

# VITE_VOXEL_SERVER_URL is retired. No frontend LiveKit URL is needed.
# SUPABASE_SECRET_KEY and LiveKit API keys/secrets belong in server env files only.
