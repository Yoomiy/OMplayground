{
  "name": "@playground/rocket-arena",
  "version": "0.1.0",
  "private": true,
  "description": "Authenticated Playground Rocket Arena game service and embedded client",
  "workspaces": [
    "shared",
    "simulation",
    "server",
    "client"
  ],
  "scripts": {
    "build": "node scripts/build-app.mjs",
    "build:engine": "tsc -b shared simulation && npm run build -w server && npm run build -w client",
    "start": "node server/dist/index.js",
    "test:app": "tsx --conditions=development scripts/check-app-integration.mts",
    "typecheck": "tsc -b",
    "test": "tsx --conditions=development --test \"shared/tests/*.test.ts\" \"simulation/tests/*.test.ts\" \"server/src/**/*.test.ts\" \"client/tests/*.test.ts\""
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
