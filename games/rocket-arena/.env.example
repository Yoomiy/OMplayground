# Runtime environment for the separate Rocket service. Never use VITE_ for secrets.
NODE_ENV=production
HOST=0.0.0.0
PORT=19006
# Lifecycle/actions by default; use debug only while collecting performance diagnostics.
LOG_LEVEL=info
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=server-only-key
# Keep stable across deployments: also verifies saved-match checkpoints.
ROCKET_TICKET_SECRET=replace-with-at-least-32-random-characters
APP_ORIGINS=https://your-playground-app.example
# Admission ceiling, not an established capacity guarantee. One process/replica.
# Same LiveKit configuration as the main game server, for the shared voice panel.
LIVEKIT_URL=wss://your-livekit-server.example
LIVEKIT_API_KEY=server-only-livekit-key
LIVEKIT_API_SECRET=server-only-livekit-secret

# App frontend build environment (set separately on the frontend hosting service):
# VITE_ROCKET_SERVICE_URL=https://your-rocket-service.example
