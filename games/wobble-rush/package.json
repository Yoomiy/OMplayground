{
  "name": "@playground/wobble-rush",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Authenticated Playground obstacle-racing service and embedded client",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "bun scripts/build.ts",
    "start": "node dist/server.mjs",
    "test": "bun test",
    "typecheck": "tsgo -p tsconfig.client.json && tsgo -p tsconfig.server.json",
    "lint": "biome check src tests scripts",
    "test:app": "node --import tsx scripts/check-app-integration.ts",
    "test:graphics": "bun scripts/check-graphics.ts",
    "test:soak": "node --import tsx scripts/check-runtime-load.ts",
    "check:physics": "bun scripts/check-physics.ts",
    "check:prediction": "bun scripts/check-prediction-cost.ts"
  },
  "dependencies": {
    "livekit-server-sdk": "2.15.4",
    "pino": "9.14.0",
    "three": "0.185.1",
    "ws": "8.21.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "@playwright/test": "1.62.0",
    "@types/bun": "1.3.14",
    "@types/node": "26.1.1",
    "@types/three": "0.185.1",
    "@types/ws": "8.18.1",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "bun": "1.4.3",
    "pino-pretty": "13.1.3",
    "tsx": "4.22.3",
    "typescript": "7.0.2"
  },
  "allowScripts": {
    "bun@1.4.3": true,
    "esbuild@0.28.2": true
  }
}
