{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "lib": [
      "ES2023",
      "DOM"
    ],
    "resolveJsonModule": true
  },
  "include": [
    "src/**/*.ts",
    "content/**/*.ts",
    "tools/**/*.ts",
    "tests/**/*.ts"
  ]
}
