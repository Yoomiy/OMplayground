{
  "name": "@playground/voxel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.21.0"
  },
  "scripts": {
    "content": "node tools/compile-content.ts",
    "inventory:legacy": "node tools/inventory-legacy-content.ts",
    "check:content": "node tools/check-content-disposition.ts",
    "check:content:complete": "node tools/check-content-disposition.ts --require-complete",
    "survey:content": "node tools/survey-content.ts",
    "build:engine": "node tools/build-engine.mjs",
    "build": "npm run content && npm run build:engine && node tools/build-manifest.mjs && npm run build:client && npm run build:server && node tools/release-manifest.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "test:engine": "cargo test --release --locked --manifest-path engine/Cargo.toml",
    "test:wasm": "node --test tests/wasm/*.test.ts",
    "check:boundaries": "node tools/check-boundaries.mjs",
    "check": "npm run build && npm run typecheck && npm run check:content:complete && npm run check:boundaries && npm test && npm run test:engine && npm run test:wasm && npm run test:integration && npm run test:server-bundle",
    "test:browser": "node tools/browser-smoke.ts",
    "benchmark:engine": "node tools/benchmark-engine.ts",
    "benchmark:survival": "node tools/benchmark-survival.ts",
    "benchmark:sockets": "node tools/benchmark-sockets.mjs",
    "benchmark:survival:workers": "node tools/benchmark-survival-workers.ts",
    "check:survival:workers": "node tools/check-survival-workers.ts",
    "dev": "node tools/dev.ts",
    "build:client": "vite build",
    "test:integration": "node --test tests/integration/*.test.ts",
    "test:server-bundle": "node tools/test-server-bundle.mjs",
    "build:server": "node tools/build-server.mjs",
    "verify:release": "node tools/verify-release.mjs",
    "test:creative:browser": "node tools/browser-creative.ts",
    "test:touch:browser": "node tools/browser-touch.ts",
    "test:environment:browser": "node tools/browser-environment.ts",
    "test:presentation:browser": "node tools/browser-presentation.ts",
    "test:memory:probe": "node tools/check-browser-memory-probe.ts",
    "test:memory:browser": "node tools/browser-travel-memory.ts",
    "check:memory:browser": "node tools/check-travel-memory.ts",
    "test:recovery:browser": "node tools/browser-worker-recovery.ts",
    "test:inventory:browser": "node tools/browser-inventory.ts",
    "test:survival:browser": "node tools/browser-survival.ts",
    "test:tnt:browser": "VOXEL_SURVIVAL_TNT=1 node tools/browser-survival.ts",
    "test:equipment:browser": "VOXEL_SURVIVAL_EQUIPMENT=1 node tools/browser-survival.ts",
    "test:bucket:browser": "VOXEL_SURVIVAL_BUCKET=1 node tools/browser-survival.ts",
    "test:held:browser": "node tools/browser-held-bucket.ts",
    "test:combat:browser": "node tools/browser-combat.ts",
    "format": "prettier --write \"src/**/*.ts\" \"tools/*.{ts,mjs}\" \"tests/**/*.ts\" \"content/*.ts\" vite.config.ts index.html \"src/client/*.css\""
  },
  "dependencies": {
    "ws": "8.21.3",
    "three": "0.186.0"
  },
  "devDependencies": {
    "@types/node": "22.19.17",
    "@types/ws": "8.18.1",
    "typescript": "5.9.3",
    "wasm-pack": "0.15.0",
    "playwright": "1.64.0",
    "@types/three": "0.186.0",
    "vite": "8.3.5",
    "esbuild": "0.28.2",
    "prettier": "3.6.2"
  }
}
