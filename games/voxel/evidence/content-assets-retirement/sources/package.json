{
  "name": "playground-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "postinstall": "cd \"$(npm prefix)\" && npx --no-install patch-package",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "dev:web": "npm run dev -w @playground/web",
    "dev:server": "npm run dev -w @playground/game-server",
    "dev:rocket": "node scripts/dev-rocket.mjs",
    "lint": "npm run lint --workspaces --if-present",
    "dev:wobble": "node scripts/dev-wobble.mjs",
    "build:voxel": "npm --prefix games/voxel run build",
    "check:voxel": "npm --prefix games/voxel run check",
    "test:voxel:browser": "npm --prefix games/voxel run test:browser",
    "test:voxel:creative": "npm --prefix games/voxel run test:creative:browser",
    "test:voxel:touch": "npm --prefix games/voxel run test:touch:browser",
    "test:voxel:environment": "npm --prefix games/voxel run test:environment:browser",
    "test:voxel:presentation": "npm --prefix games/voxel run test:presentation:browser",
    "test:voxel:recovery": "npm --prefix games/voxel run test:recovery:browser",
    "test:voxel:inventory": "npm --prefix games/voxel run test:inventory:browser",
    "test:voxel:survival": "npm --prefix games/voxel run test:survival:browser",
    "test:voxel:tnt": "npm --prefix games/voxel run test:tnt:browser",
    "test:voxel:equipment": "npm --prefix games/voxel run test:equipment:browser",
    "test:voxel:combat": "npm --prefix games/voxel run test:combat:browser",
    "dev:voxel": "npm run build:voxel && npm --prefix games/voxel run dev",
    "dev:classroom": "node scripts/dev-service-start.mjs classroom",
    "predev:app": "npm run build --workspace @playground/game-logic && npm run build --workspace @playground/observability",
    "dev:app": "node scripts/dev-app.mjs",
    "predev:voxel-server": "npm run build --workspace @playground/game-logic && npm run build --workspace @playground/observability && npm --prefix games/voxel run verify:release",
    "dev:voxel-server": "node scripts/dev-service-start.mjs voxel",
    "predev:classroom": "npm run build --workspace @playground/observability",
    "test:dev": "node --test scripts/dev-app.test.mjs"
  },
  "devDependencies": {
    "tsx": "^4.22.3",
    "typescript": "^5.8.2"
  },
  "dependencies": {
    "livekit-server-sdk": "^2.15.4",
    "patch-package": "^8.0.1"
  }
}
